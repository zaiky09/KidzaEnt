# Server
PORT=5000
NODE_ENV=development

# Allowed origin for CORS and Socket.IO. Use '*' in dev; set to your domain in prod.
CORS_ORIGIN=*

# Base URL the password-reset email links should point at.
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/kidzaent

# Authentication — required; the server will refuse to boot without these.
JWT_SECRET=replace-with-a-long-random-string

# Gemini AI
GEMINI_API_KEY=your-google-ai-studio-key

# Email (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-password

# M-Pesa Daraja (Safaricom)
# Get key + secret from https://developer.safaricom.co.ke -> your app
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
# Shared sandbox values; replace for production
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Public HTTPS URL Safaricom will POST to. In dev: ngrok URL + /api/payments/callback
MPESA_CALLBACK_URL=https://your-ngrok-id.ngrok-free.app/api/payments/callback
