# Server
PORT=5000
NODE_ENV=development

# Allowed origin for CORS and Socket.IO. Use '*' in dev; set to your domain in prod.
CORS_ORIGIN=*

# Base URL the password-reset email links should point at.
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/kidzaent

# Authentication — required; the server will refuse to boot without these.
JWT_SECRET=replace-with-a-long-random-string

# Gemini AI
GEMINI_API_KEY=your-google-ai-studio-key

# Email (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-password
