{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd marketplace-frontend && npm ci && npm run build",
  "installCommand": "echo 'install handled in buildCommand to keep root scope clean'",
  "outputDirectory": "marketplace-frontend/dist",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ]
}
