# Base URL of the Kidza backend API. Override per environment.
VITE_API_URL=http://localhost:5000

# Google Maps Platform — see README for restrictions to apply.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Cloudinary — used for driver KYC photo uploads (unsigned).
# Sign up at cloudinary.com, then Settings → Upload → Add upload preset (Unsigned).
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=kidza_unsigned
